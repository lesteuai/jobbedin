# Postgres configs
PGUSER=
PGPASSWORD=
PGHOST=
PGPORT=
PGDATABASE=

# Some Postgres databases require SSL like NeonDB
PGSSL=false

# Better Auth configs
BETTER_AUTH_SECRET=your-secret-here
ORIGIN=https://your-production-domain.com
ORIGIN_DEV=http://localhost:3000

# AI and tools
OPENROUTER_API_KEY=
TAVILY_API_KEY=
REASONING_MODEL=
WRITING_MODEL=

# Email (nodemailer). NEXT_PUBLIC_EMAIL_ENABLED=false disables all outbound email for local runs.
# NEXT_PUBLIC_ is used because EMAIL_ENABLED needs to show up in the browser.
NEXT_PUBLIC_EMAIL_ENABLED=false

# EMAIL_PROVIDER=gmail uses Gmail OAuth2; anything else uses plain SMTP below.
EMAIL_PROVIDER=smtp

# Gmail OAuth2 (used when EMAIL_PROVIDER=gmail)
GMAIL_USER=you@gmail.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Plain SMTP (used when EMAIL_PROVIDER is not gmail)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Separate key for send origin
SMTP_FROM=JobbedIn <no-reply@your-domain.com>